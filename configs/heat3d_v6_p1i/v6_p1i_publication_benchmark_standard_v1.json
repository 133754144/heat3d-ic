    "resident_core": "prepared payload already device resident; synchronized neural core or prepared FVM solve only; never called E2E",
    "true_B16_to_B32_marginal": "(continuous_B32_wall-continuous_B16_wall)/16 on 32 distinct cases",
    "Q1": "submit one distinct case only after previous 240825 result completes",
    "Q2": "submit two distinct cases, then refill one only after a completion; report submit_to_result, inter_completion, and samples_per_second"
  },
  "required_reports": [
    "cold_service_first_case_seconds",
    "fresh_distinct_case_median_and_p95_seconds",
