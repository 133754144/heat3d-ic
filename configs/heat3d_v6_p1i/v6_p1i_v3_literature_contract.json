  "parameter_contracts": {
    "top_h_W_m2K": {
      "v3_range": [500.0, 1600.0],
      "supporting_sources": ["P1I3-L01", "P1I3-L06"],
      "interpretation": "Continuous effective Robin coefficient spanning strong package convection; it is not a universal heatsink HTC."
    },
    "bottom_h_W_m2K": {
      "v3_range": [20.0, 200.0],
      "supporting_sources": ["P1I3-L06"],
      "interpretation": "Weak-to-moderate board-side effective Robin path; lower values are an engineering extension toward weak cooling and remain explicitly labeled."
    },
    "package_total_power_W": {
      "v3_allowed_range": [1.7, 20.0],
      "supporting_sources": ["P1I3-L04", "P1I3-L08"],
      "interpretation": "Package/component scale for a 10 x 10 mm footprint; generated continuously and never backsolved from temperature."
    },
    "surface_power_density_W_cm2": {
      "v3_guardrail": [1.0, 1000.0],
      "supporting_sources": ["P1I3-L07"],
      "interpretation": "Conservative envelope below the cited 2100 W/cm2 local hotspot; each source is checked before solving."
    },
    "volumetric_q_W_m3": {
      "v3_guardrail": [100000000.0, 80000000000.0],
      "supporting_sources": ["P1I3-L01", "P1I3-L02", "P1I3-L07"],
      "interpretation": "Not claimed as a directly measured literature interval. q is exactly power fraction divided by resolved source volume; the bound enforces source power, area and thickness plausibility."
    },
    "local_k_W_mK": {
      "v3_range": [20.0, 400.0],
      "supporting_sources": ["P1I3-L02", "P1I3-L03", "P1I3-L04", "P1I3-L05", "P1I3-L06"],
      "interpretation": "Effective heterogeneous local regions, not a bulk-silicon-only interval. Material meaning must remain explicit."
    },
    "source_planform_fraction": {
      "v3_width_height_range": [0.08, 0.14],
      "physical_size_for_10mm_package_m": [0.0008, 0.0014],
      "supporting_sources": ["P1I3-L07", "P1I3-L08"],
      "interpretation": "Resolved local sources; literature includes smaller 0.2 mm hotspots, while V3 deliberately uses a mesh-resolved conservative scale."
    },
    "layer_thickness_m": {
      "supporting_sources": ["P1I3-L03", "P1I3-L05", "P1I3-L09"],
      "interpretation": "Nine-layer stack thicknesses remain fixed; no thickness is silently sampled."
    }
  }
}
